import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/account?welcome=1");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Create an account · PackPass</title>
    <meta name="description" content="Join PackPass Studio to book yoga and Pilates classes.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-form">
        <div class="stack is-lg signup-wrap">
          <div class="stack is-sm">
            <p class="eyebrow">Join the studio</p>
            <h1>Create your account</h1>
            <p class="lede">Then pick a 5 or 10 class pack, or go unlimited, and book your first class.</p>
          </div>

          <form class="card" onsubmit={() => onSubmit(form)}>
            <div class="card-body stack">
              <p e:if={form.error} class="callout is-danger" role="alert">{form.error}</p>

              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" value={form.name} autocomplete="name" placeholder="Ada Lovelace" required>
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email"
                       name="email"
                       type="email"
                       value={form.email}
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="you@example.com"
                       required>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       value={form.password}
                       autocomplete="new-password"
                       minlength={MIN_PASSWORD}
                       required>
                <p class="hint">At least {MIN_PASSWORD} characters.</p>
              </div>

              <button type="submit" class="is-primary is-block" disabled={form.busy}>Create account</button>

              <p class="signup-alt">Already a member? <a class="link-action" href="/signin">Sign in</a></p>
            </div>
          </form>
        </div>
      </div>
    </Layout>
  </body>
</html>
